{
  "manifest_version": 3,
  "name": "RuHub - Русский GitHub + Утилиты",
  "version": "1.0",
  "description": "Русификатор интерфейса GitHub с полезными кнопками для разработчиков.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Настройки RuHub"
  }
}
